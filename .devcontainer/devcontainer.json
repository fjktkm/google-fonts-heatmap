{
	"name": "maturin (uv)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"mounts": [
		{
			"source": "uv",
			"target": "/home/vscode/.cache/uv",
			"type": "volume"
		},
		{
			"target": "${containerWorkspaceFolder}/.venv",
			"type": "volume"
		},
		{
			"target": "${containerWorkspaceFolder}/target",
			"type": "volume"
		},
		{
			"source": "data-${devcontainerId}",
			"target": "${containerWorkspaceFolder}/data",
			"type": "volume"
		}
	],
	"containerEnv": {
		"UV_LINK_MODE": "copy"
	},
	"onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache/uv .venv target data && uv sync",
	"customizations": {
		"vscode": {
			"extensions": [
				"astral-sh.ty",
				"charliermarsh.ruff",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml"
			]
		}
	},
	"remoteUser": "vscode"
}
